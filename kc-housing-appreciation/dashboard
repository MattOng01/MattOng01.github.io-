  <style>
    :root {
      --color-brand:       #1a1a2e;
      --color-accent:      #0B2E59;
      --color-accent-mid:  #4575A5;
      --color-text-light:  #ffffff;
      --color-text-muted:  #aaaaaa;
      --font-display:      'Playfair Display', Georgia, serif;
      --font-body:         'DM Sans', 'Helvetica Neue', Arial, sans-serif;
      --container-max:     860px;
    }

    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: var(--font-body);
      background: #f4f4f4;
      color: #222;
    }

    .back-nav {
      background: var(--color-brand);
      padding: 10px 0;
    }

    .back-nav .container {
      max-width: var(--container-max);
      margin: 0 auto;
      padding: 0 24px;
    }

    .back-link {
      color: var(--color-text-muted);
      text-decoration: none;
      font-size: 13px;
      letter-spacing: 0.3px;
      transition: color 0.15s;
    }

    .back-link:hover { color: var(--color-text-light); }
    
    header {
      background: var(--color-brand);
      color: var(--color-text-light);
      padding: 36px 0 32px;
      border-bottom: 3px solid var(--color-accent);
    }

    header .container {
      max-width: var(--container-max);
      margin: 0 auto;
      padding: 0 24px;
    }

    .eyebrow {
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 1.4px;
      text-transform: uppercase;
      color: var(--color-text-muted);
      margin-bottom: 12px;
    }

    header h1 {
      font-family: var(--font-display);
      font-size: clamp(22px, 4vw, 34px);
      font-weight: 700;
      line-height: 1.25;
      margin-bottom: 14px;
    }

    .meta {
      font-size: 13px;
      color: var(--color-text-muted);
      margin-bottom: 16px;
    }

    .tool-badges {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .badge {
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.4px;
      padding: 4px 10px;
      border-radius: 4px;
      border: 1px solid rgba(255,255,255,0.2);
      color: rgba(255,255,255,0.75);
      background: rgba(255,255,255,0.07);
    }

    .container {
      max-width: var(--container-max);
      margin: 0 auto;
      padding: 0 24px;
    }

    main {
      padding: 40px 0 0;
    }

    .repo-strip {
      margin-bottom: 40px;
      border: 1px solid #ddd;
      border-radius: 8px;
      overflow: hidden;
      background: #fff;
    }

    .repo-strip a {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 13px 16px;
      text-decoration: none;
      color: var(--color-accent);
      font-size: 13px;
      border-bottom: 1px solid #eee;
      transition: background 0.12s;
    }

    .repo-strip a:last-child { border-bottom: none; }
    .repo-strip a:hover { background: #f5f8fc; }

    .repo-label {
      font-weight: 600;
      white-space: nowrap;
    }

    .repo-url {
      color: #888;
      font-size: 12px;
      flex: 1;
    }

    .repo-arrow {
      color: #bbb;
      font-size: 14px;
      margin-left: auto;
    }

    /* ═══════════════════════════════════════════════════
       SECTION HEADINGS
    ═══════════════════════════════════════════════════ */
    section { margin-bottom: 40px; }

    section h2 {
      font-family: var(--font-display);
      font-size: 22px;
      font-weight: 700;
      color: var(--color-accent);
      margin-bottom: 16px;
      padding-bottom: 8px;
      border-bottom: 1px solid #ddd;
    }

    section p {
      font-size: 15px;
      line-height: 1.75;
      color: #333;
      margin-bottom: 12px;
    }

    /* ═══════════════════════════════════════════════════
       TABLEAU EMBED SECTION
    ═══════════════════════════════════════════════════ */
    #tableau-section {
      background: #fff;
      padding: 40px 0 48px;
      border-top: 1px solid #e0e0e0;
      border-bottom: 1px solid #e0e0e0;
      margin: 0 0 40px;
    }

    #tableau-section .container h2 {
      font-family: var(--font-display);
      font-size: 22px;
      font-weight: 700;
      color: var(--color-accent);
      margin-bottom: 6px;
      padding-bottom: 8px;
      border-bottom: 1px solid #ddd;
    }

    .tableau-caption {
      font-size: 13px;
      color: #888;
      margin-bottom: 24px;
      font-style: italic;
    }

    .tableau-wrapper {
      /* Tableau's own script controls width/height — we just center it */
      display: flex;
      justify-content: center;
    }

    /* Constrain embed on very wide screens */
    .tableau-wrapper > div {
      width: 100% !important;
      max-width: 1000px;
    }

    /* ═══════════════════════════════════════════════════
       FINDINGS
    ═══════════════════════════════════════════════════ */
    .findings {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .finding {
      display: flex;
      gap: 16px;
      align-items: flex-start;
      background: #fff;
      border: 1px solid #e0e0e0;
      border-left: 4px solid var(--color-accent);
      border-radius: 6px;
      padding: 16px 18px;
    }

    .finding-num {
      font-family: var(--font-display);
      font-size: 20px;
      font-weight: 700;
      color: var(--color-accent);
      min-width: 28px;
      line-height: 1.4;
    }

    .finding p {
      margin: 0;
      font-size: 14px;
      line-height: 1.7;
      color: #333;
    }

    /* ═══════════════════════════════════════════════════
       DATA TABLE
    ═══════════════════════════════════════════════════ */
    .data-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
      background: #fff;
      border: 1px solid #ddd;
      border-radius: 6px;
      overflow: hidden;
    }

    .data-table th {
      background: var(--color-brand);
      color: var(--color-text-light);
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.6px;
      text-transform: uppercase;
      padding: 10px 14px;
      text-align: left;
    }

    .data-table td {
      padding: 10px 14px;
      border-top: 1px solid #eee;
      color: #333;
    }

    .data-table tr:hover td { background: #f8f9fc; }

    .data-table a {
      color: var(--color-accent-mid);
      text-decoration: none;
    }

    .data-table a:hover { text-decoration: underline; }

    /* ═══════════════════════════════════════════════════
       FOOTER
    ═══════════════════════════════════════════════════ */
    footer {
      background: var(--color-brand);
      color: var(--color-text-muted);
      padding: 18px 0;
      font-size: 13px;
      letter-spacing: 0.3px;
    }

    .footer-content {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 8px;
    }

    .footer-links {
      display: flex;
      gap: 10px;
      align-items: center;
    }

    .footer-links a {
      color: var(--color-text-muted);
      text-decoration: underline;
      transition: color 0.15s;
    }

    .footer-links a:hover { color: var(--color-text-light); }

    /* ═══════════════════════════════════════════════════
       RESPONSIVE
    ═══════════════════════════════════════════════════ */
    @media (max-width: 600px) {
      header { padding: 24px 0 20px; }
      main { padding: 28px 0 0; }
      section h2 { font-size: 18px; }
      .footer-content { flex-direction: column; align-items: flex-start; }
    }
  </style>
</head>

